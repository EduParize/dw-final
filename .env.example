POSTGRES_USER=dwfinal
POSTGRES_PASSWORD=dwfinal
POSTGRES_DB=dw_final
POSTGRES_PORT=5433
# Dentro do Docker o host é "postgres". Rodando o backend fora do Docker, use:
# DATABASE_URL=postgres://dwfinal:dwfinal@localhost:5433/dw_final
DATABASE_URL=postgres://dwfinal:dwfinal@postgres:5432/dw_final

PORT=3000
BACKEND_PORT=3001
FRONTEND_PORT=8080
FRONTEND_DEV_PORT=5173

# Autenticação: troque o segredo por um valor longo e aleatório
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

VITE_API_URL=/api
